// --- CONFIGURATION: SMMC CLUB MANAGEMENT ---
const CLUB_MANAGEMENT_SPREADSHEET_ID = "1nFqeV1U0c_RLaZK4amf7QR1MMwB9q8gZLc4HriUH9iI";

// --- CONFIGURATION: GOOGLE FORM BASE URLs ---
const SECONDER_FORM_URL = "https://docs.google.com/forms/d/e/1FAIpQLSfF1IGPx0JfBfLRYHLKb6RnW9O7AHOfwj_EkdvDAWMQnEbDyQ/viewform";
const ACCEPTANCE_FORM_URL = "https://docs.google.com/forms/d/e/1FAIpQLSeYJSXcOKjRAW8LEPcvWRaSCNwyYTaVfuJJKWubKCFE0poANA/viewform";

// --- CONFIGURATION: UPDATE THESE ENTRY IDs ---
const SEC_SUMMARY_ENTRY_ID = "entry.1778247585"; // Summary Paragraph on Seconder Form
const SEC_ID_ENTRY_ID      = "entry.1953195549"; // Hidden ID on Seconder Form

const ACC_SUMMARY_ENTRY_ID = "entry.1302766795"; // Summary Paragraph on Acceptance Form
const ACC_ID_ENTRY_ID      = "entry.1778247585"; // Hidden ID on Acceptance Form
// ----------------------------------------------

function updateDashboard() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const dashSheet = ss.getSheetByName("Dashboard");
  const nomSheet = ss.getSheetByName("Nominations");
  const secSheet = ss.getSheetByName("Seconders");
  const accSheet = ss.getSheetByName("Acceptances");
  
  // Clear dashboard data rows (Now clearing Columns A through J)
  if (dashSheet.getLastRow() > 1) {
    dashSheet.getRange(2, 1, dashSheet.getLastRow() - 1, 10).clear();
  }
  
  const nomLastRow = nomSheet.getLastRow();
  if (nomLastRow < 2) return; 
  
  const nomFullData = nomSheet.getRange(2, 1, nomLastRow - 1, 5).getValues();
  const secData = secSheet.getLastRow() > 1 ? secSheet.getRange(2, 1, secSheet.getLastRow() - 1, 5).getValues() : []; 
  const accData = accSheet.getLastRow() > 1 ? accSheet.getRange(2, 1, accSheet.getLastRow() - 1, 2).getValues() : []; 

  // --- FETCH MASTER MEMBER LIST FOR VALIDATION ---
  let masterMembers = {};
  try {
    const clubMgmtFile = SpreadsheetApp.openById(CLUB_MANAGEMENT_SPREADSHEET_ID);
    const membersSheet = clubMgmtFile.getSheetByName("Members");
    const membersData = membersSheet.getRange(2, 1, membersSheet.getLastRow() - 1, 9).getValues(); // Columns A to I
    
    // Map member names to their active status and email address
    for (let m = 0; m < membersData.length; m++) {
      let status = String(membersData[m][1]).trim().toLowerCase(); // Column B: Active
      let name = String(membersData[m][2]).trim().toLowerCase();   // Column C: MemberName
      let email = String(membersData[m][8]).trim();                // Column I: email
      
      masterMembers[name] = {
        isActive: (status === "active"),
        email: email
      };
    }
  } catch (err) {
    Logger.log("Error opening Club Management sheet: " + err.message);
  }

  let textOutput = [];
  let actionOutput = []; 
  
  // Keep track of who we need to send alert emails to on this execution loop
  let emailQueue = [];

  for (let i = 0; i < nomFullData.length; i++) {
    let nomId = "NOM-" + (i + 1);
    let position = nomFullData[i][2];
    let nominee = nomFullData[i][3];
    let nominator = nomFullData[i][4];
    
    // Clean string name for map checking
    let cleanNomineeName = String(nominee).trim().toLowerCase();
    let isMemberValid = masterMembers.hasOwnProperty(cleanNomineeName) && masterMembers[cleanNomineeName].isActive;
    let nomineeEmail = isMemberValid ? masterMembers[cleanNomineeName].email : "";

    // Find the row matching our Nomination ID in the Seconder data array
    let seconderRow = secData.find(row => row[4] == nomId);
    let isSeconded = !!seconderRow; // True if row exists, false if not
    
    // If found, extract Seconder Name from index 2. If not, leave blank.
    let seconderName = isSeconded ? seconderRow[2] : "";
    let secStatus = isSeconded ? "✅ Yes" : "❌ No";
    
    let isAccepted = accData.some(row => row[1] == nomId);
    let accStatus = isAccepted ? "✅ Yes" : "❌ No";
    
    // Set validation and locking statuses
    let status = "Incomplete";
    if (!isMemberValid) {
      status = "❌ INVALID MEMBER";
    } else if (isSeconded && isAccepted) {
      status = "🔒 VALID & LOCKED";
    }
    
    let actionSlot1 = "";
    let actionSlot2 = "";
    
    // Define summary paragraphs
    let secSummaryText = `You are seconding the nomination of ${nominee} for the position of ${position} (Nominated by ${nominator}).`;
    let accSummaryText = `I, ${nominee}, hereby accept the nomination for the position of ${position} (Nominated by ${nominator}).`;
    
    // Only construct action links if the nominee name is a verified, active member
    if (!isMemberValid) {
      actionSlot1 = "Check Master Roster Name";
      actionSlot2 = "";
    } else if (isSeconded && isAccepted) {
      actionSlot1 = "Nomination Complete";
      actionSlot2 = "";
    } else {
      let secLink = `${SECONDER_FORM_URL}?usp=pp_url&${SEC_SUMMARY_ENTRY_ID}=${encodeURIComponent(secSummaryText)}&${SEC_ID_ENTRY_ID}=${encodeURIComponent(nomId)}`;
      let accLink = `${ACCEPTANCE_FORM_URL}?usp=pp_url&${ACC_SUMMARY_ENTRY_ID}=${encodeURIComponent(accSummaryText)}&${ACC_ID_ENTRY_ID}=${encodeURIComponent(nomId)}`;
      
      if (!isSeconded && !isAccepted) {
        actionSlot1 = `=HYPERLINK("${secLink}", "➡️ Second Here")`;
        
        // Add to email queue if this is the very first time processing a fresh nomination row
        if (nomSheet.getRange(2 + i, 1).getNote() !== "Notification Sent" && nomineeEmail) {
          emailQueue.push({
            email: nomineeEmail,
            nominee: nominee,
            position: position,
            nominator: nominator,
            link: accLink,
            noteCell: nomSheet.getRange(2 + i, 1)
          });
        }
      } else if (!isSeconded && isAccepted) {
        actionSlot1 = `=HYPERLINK("${secLink}", "➡️ Second Here")`;
      } 
    }
    
    // Push core data values (Columns A through H)
    textOutput.push([nomId, position, nominee, nominator, seconderName, secStatus, accStatus, status]);
    actionOutput.push([actionSlot1, actionSlot2]);
  }
  
  // Write core text data to Columns A through H (width: 8)
  if (textOutput.length > 0) {
    dashSheet.getRange(2, 1, textOutput.length, 8).setValues(textOutput);
    
    // Write dynamic action links to Columns I and J (index 9 and 10)
    for (let j = 0; j < actionOutput.length; j++) {
      let cellI = dashSheet.getRange(2 + j, 9); 
      let cellJ = dashSheet.getRange(2 + j, 10); 
      
      let valI = actionOutput[j][0];
      let valJ = actionOutput[j][1];
      
      if (valI.startsWith("=")) { cellI.setFormula(valI); } else { cellI.setValue(valI); }
      if (valJ.startsWith("=")) { cellJ.setFormula(valJ); } else { cellJ.setValue(valJ); }
    }
  }

  // --- SEND UN-SENT EMAIL NOTIFICATIONS ---
  for (let k = 0; k < emailQueue.length; k++) {
    let target = emailQueue[k];
    
    let subject = `SMMC Committee Nomination: ${target.position}`;
    let body = `Hi ${target.nominee},\n\n` +
               `You have been nominated for the committee position of ${target.position} by ${target.nominator}.\n\n` +
               `To finalize this process, please review and accept your nomination by clicking the link below:\n` +
               `${target.link}\n\n` +
               `Best regards,\n` +
               `SMMC Committee Election System`;
               
    MailApp.sendEmail(target.email, subject, body);
    target.noteCell.setNote("Notification Sent");
  }
}

