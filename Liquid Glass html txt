<!DOCTYPE html>
<!--
  RC SAILING CLUB — LIQUID GLASS TEMPLATE
  =========================================
  This is built to become the shared shell for your Apps Script Web App.
  Suggested split when you move this into your Apps Script project:

    Styles.html      -> everything inside the <style> block below
    Header.html      -> the <header class="nav-glass">...</header> block
    Footer.html       -> the <footer>...</footer> block
    Home.html         -> hero + tile grid (this file's <main>)
    Dashboard.html,
    Individual.html,
    Calendar.html,
    Weather.html      -> new files that reuse Header/Footer via:
                         <?!= include('Header'); ?>
                         ...page content...
                         <?!= include('Footer'); ?>

  Every page that includes Header.html + Styles.html automatically inherits
  this look, so the whole site stays visually consistent with almost no
  repeated CSS. Nav links use ?view=xxx to match the doGet(e) router pattern
  discussed earlier.
-->
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Sydney Maritime Modellers Club</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style> 

  /* =========================================================
     DESIGN TOKENS — change these to re-skin every page at once
     ========================================================= */
  :root{
    --ocean-deep:   #071b2c;
    --ocean-mid:    #0f3550;
    --sea-teal:     #164a56;
    --foam:         #eaf6f6;
    --foam-dim:     rgba(234,246,246,0.62);
    --signal:       #ff6a3d;   /* regatta / burgee accent */
    --glow:         #5eead4;   /* wake / bioluminescent accent */

    --glass-fill:   rgba(255,255,255,0.06);
    --glass-fill-hi:rgba(255,255,255,0.11);
    --glass-border: rgba(255,255,255,0.16);
    --glass-blur:   18px;

    --font-display: 'Space Grotesk', sans-serif;
    --font-body:    'Inter', sans-serif;
    --font-data:    'JetBrains Mono', monospace;
  }

  *{ box-sizing:border-box; margin:0; padding:0; }

  html{ scroll-behavior:smooth; }

  body{
    font-family:var(--font-body);
    color:var(--foam);
    min-height:100vh;
    background:
      radial-gradient(ellipse 900px 500px at 15% -10%, rgba(94,234,212,0.10), transparent 60%),
      radial-gradient(ellipse 700px 500px at 100% 0%, rgba(255,106,61,0.08), transparent 55%),
      linear-gradient(180deg, var(--ocean-deep) 0%, var(--ocean-mid) 55%, var(--sea-teal) 100%);
    overflow-x:hidden;
    position:relative;
  }

  /* Subtle moving caustic light — water without a hero photo */
  body::before{
    content:"";
    position:fixed; inset:-20%;
    background:
      repeating-linear-gradient(115deg,
        rgba(255,255,255,0.025) 0px,
        rgba(255,255,255,0.025) 2px,
        transparent 2px,
        transparent 140px);
    animation:drift 22s linear infinite;
    pointer-events:none;
    z-index:0;
  }
  @keyframes drift{
    0%{ transform:translate(0,0); }
    100%{ transform:translate(-140px,80px); }
  }

  /* =========================================================
     GLASS PRIMITIVE — the one reusable surface every card uses
     ========================================================= */
  .glass{
    background:linear-gradient(155deg, var(--glass-fill-hi), var(--glass-fill));
    border:1px solid var(--glass-border);
    border-radius:20px;
    backdrop-filter:blur(var(--glass-blur)) saturate(140%);
    -webkit-backdrop-filter:blur(var(--glass-blur)) saturate(140%);
    box-shadow:
      0 1px 0 rgba(255,255,255,0.25) inset,
      0 -1px 12px rgba(255,255,255,0.03) inset,
      0 18px 40px rgba(2,10,18,0.35);
    position:relative;
  }
  /* thin specular sweep along the top edge, like light on glass */
  .glass::after{
    content:"";
    position:absolute; inset:0;
    border-radius:inherit;
    background:linear-gradient(120deg, rgba(255,255,255,0.14) 0%, transparent 30%);
    pointer-events:none;
  }

  /* =========================================================
     NAV
     ========================================================= */
  .nav-glass{
    position:sticky; top:0; z-index:50;
    display:flex; align-items:center; justify-content:space-between;
    gap:16px;
    padding:14px 28px;
    margin:0;
    border-radius:0;
    border-left:none; border-right:none; border-top:none;
    backdrop-filter:blur(20px) saturate(150%);
    -webkit-backdrop-filter:blur(20px) saturate(150%);
    background:rgba(7,27,44,0.55);
    border-bottom:1px solid var(--glass-border);
  }
  .nav-glass::after{ display:none; }

  .brand{ display:flex; align-items:center; gap:12px; text-decoration:none; }

  .logo{ width:38px; height:38px; flex:none; }

  .brand-text{ display:flex; flex-direction:column; line-height:1.05; }
  .brand-text strong{
    font-family:var(--font-display); font-size:17px; letter-spacing:0.01em; color:var(--foam);
  }
  .brand-text span{
    font-family:var(--font-data); font-size:10.5px; letter-spacing:0.14em;
    text-transform:uppercase; color:var(--glow);
  }

  .nav-links{ display:flex; gap:4px; align-items:center; }
  .nav-links a{
    font-family:var(--font-body); font-size:13.5px; font-weight:500;
    color:var(--foam-dim); text-decoration:none;
    padding:8px 14px; border-radius:10px;
    transition:background 0.2s ease, color 0.2s ease;
  }
  .nav-links a:hover, .nav-links a:focus-visible{
    background:var(--glass-fill-hi); color:var(--foam);
    outline:none;
  }
  .nav-links a.current{ color:var(--ocean-deep); background:var(--glow); }

  @media (max-width:760px){
    .nav-links{ display:none; }
  }

  /* =========================================================
     HERO
     ========================================================= */
  main{ position:relative; z-index:1; }

  .hero{
    max-width:1180px; margin:0 auto;
    padding:72px 28px 40px;
    display:grid; grid-template-columns:1.1fr 0.9fr; gap:48px; align-items:center;
  }
  @media (max-width:900px){
    .hero{ grid-template-columns:1fr; padding-top:48px; text-align:center; }
    .hero .binnacle-wrap{ order:-1; margin:0 auto; }
  }

  .eyebrow{
    display:inline-flex; align-items:center; gap:8px;
    font-family:var(--font-data); font-size:11px; letter-spacing:0.16em;
    text-transform:uppercase; color:var(--glow);
    padding:6px 12px; border-radius:100px;
    background:var(--glass-fill); border:1px solid var(--glass-border);
    margin-bottom:22px;
  }
  .eyebrow .dot{
    width:6px; height:6px; border-radius:50%; background:var(--glow);
    box-shadow:0 0 8px var(--glow);
    animation:pulse 2.4s ease-in-out infinite;
  }
  @keyframes pulse{ 0%,100%{opacity:1;} 50%{opacity:0.35;} }

  h1{
    font-family:var(--font-display); font-weight:700;
    font-size:clamp(34px, 5vw, 58px); line-height:1.03; letter-spacing:-0.01em;
    color:var(--foam); margin-bottom:18px;
  }
  h1 em{ font-style:normal; color:var(--glow); }

  .lede{
    font-size:16.5px; line-height:1.6; color:var(--foam-dim);
    max-width:46ch; margin-bottom:30px;
  }
  @media (max-width:900px){ .lede{ margin-inline:auto; } }

  .hero-actions{ display:flex; gap:12px; flex-wrap:wrap; }
  @media (max-width:900px){ .hero-actions{ justify-content:center; } }

  .btn{
    font-family:var(--font-body); font-weight:600; font-size:14px;
    padding:12px 22px; border-radius:12px; text-decoration:none;
    display:inline-flex; align-items:center; gap:8px;
    transition:transform 0.15s ease, box-shadow 0.15s ease;
  }
  .btn:hover{ transform:translateY(-1px); }
  .btn-primary{
    background:linear-gradient(135deg, var(--glow), #38bfa1);
    color:var(--ocean-deep);
    box-shadow:0 8px 24px rgba(94,234,212,0.25);
  }
  .btn-ghost{
    background:var(--glass-fill); color:var(--foam);
    border:1px solid var(--glass-border);
  }
  .btn-ghost:hover{ background:var(--glass-fill-hi); }

  /* conditions strip — quick-glance data, styled like a readout */
  .conditions{
    display:flex; gap:10px; margin-top:34px; flex-wrap:wrap;
  }
  @media (max-width:900px){ .conditions{ justify-content:center; } }
  .cond-pill{
    padding:9px 14px; border-radius:12px;
    display:flex; flex-direction:column; gap:2px; min-width:88px;
  }
  .cond-pill .label{
    font-family:var(--font-data); font-size:9.5px; letter-spacing:0.1em;
    text-transform:uppercase; color:var(--foam-dim);
  }
  .cond-pill .value{
    font-family:var(--font-data); font-size:15px; color:var(--foam); font-weight:500;
  }
  .cond-pill .value.accent{ color:var(--signal); }

  /* =========================================================
     BINNACLE — the signature glass instrument
     ========================================================= */
  .binnacle-wrap{ display:flex; justify-content:center; }

  .binnacle{
    width:min(340px, 78vw); aspect-ratio:1;
    border-radius:50%;
    display:flex; align-items:center; justify-content:center;
    position:relative;
  }
  .binnacle::after{ border-radius:50%; }

  .binnacle-face{
    width:82%; height:82%; border-radius:50%;
    background:radial-gradient(circle at 35% 30%, rgba(255,255,255,0.10), rgba(0,0,0,0.18) 70%);
    border:1px solid var(--glass-border);
    position:relative;
    display:flex; align-items:center; justify-content:center;
  }
  .binnacle-tick{
    position:absolute; inset:0;
  }
  .binnacle-tick span{
    position:absolute; top:6px; left:50%;
    width:2px; height:12px; background:rgba(234,246,246,0.35);
    transform-origin:1px 100px;
  }
  .binnacle-label{
    position:absolute; font-family:var(--font-data); font-size:11px;
    color:var(--foam-dim); letter-spacing:0.08em;
  }
  .binnacle-needle{
    position:absolute; width:3px; height:36%; bottom:50%; left:calc(50% - 1.5px);
    background:linear-gradient(180deg, var(--signal), transparent);
    border-radius:3px; transform-origin:bottom center;
    animation:swing 8s ease-in-out infinite;
  }
  @keyframes swing{
    0%,100%{ transform:rotate(-24deg); }
    50%{ transform:rotate(31deg); }
  }
  .binnacle-hub{
    width:14px; height:14px; border-radius:50%;
    background:var(--foam); box-shadow:0 0 12px rgba(234,246,246,0.6);
    position:absolute;
  }
  .binnacle-readout{
    position:absolute; bottom:26%; text-align:center;
  }
  .binnacle-readout .n{ font-family:var(--font-data); font-size:22px; color:var(--foam); }
  .binnacle-readout .u{ font-family:var(--font-data); font-size:10px; color:var(--glow); letter-spacing:0.1em; }

  /* =========================================================
     LATEST FEED — finish-order ribbon for the most recent race
     ========================================================= */
  .feed{
    max-width:1180px; margin:0 auto; padding:0 28px;
  }
  .feed-card{
    padding:22px 22px 18px;
  }
  .feed-head{
    display:flex; align-items:center; justify-content:space-between;
    flex-wrap:wrap; gap:10px; margin-bottom:16px;
  }
  .feed-title{
    display:flex; align-items:center; gap:10px;
  }
  .feed-title .dot{
    width:7px; height:7px; border-radius:50%; background:var(--signal);
    box-shadow:0 0 8px var(--signal);
    animation:pulse 2.4s ease-in-out infinite;
  }
  .feed-title h2{
    font-family:var(--font-display); font-size:16px; font-weight:600; color:var(--foam);
  }
  .feed-meta{
    font-family:var(--font-data); font-size:11px; letter-spacing:0.08em;
    color:var(--foam-dim); text-transform:uppercase;
  }

  .ribbon{
    display:flex; gap:12px; overflow-x:auto; padding:4px 2px 10px;
    scroll-snap-type:x proximity;
    -webkit-overflow-scrolling:touch;
  }
  .ribbon::-webkit-scrollbar{ height:6px; }
  .ribbon::-webkit-scrollbar-thumb{ background:var(--glass-border); border-radius:10px; }

  .finish-chip{
    scroll-snap-align:start;
    flex:none; width:150px;
    padding:14px 14px 12px;
    display:flex; flex-direction:column; gap:8px;
    background:var(--glass-fill);
    border:1px solid var(--glass-border);
    border-radius:14px;
    position:relative;
    transition:transform 0.15s ease, border-color 0.15s ease;
  }
  .finish-chip:hover{ transform:translateY(-3px); border-color:rgba(94,234,212,0.35); }

  .finish-chip .pos{
    font-family:var(--font-data); font-size:22px; font-weight:500; color:var(--foam);
    display:flex; align-items:baseline; gap:4px;
  }
  .finish-chip .pos small{ font-size:11px; color:var(--foam-dim); font-weight:400; }

  .finish-chip .sailor{
    font-family:var(--font-body); font-size:13.5px; font-weight:600; color:var(--foam);
    line-height:1.25;
  }
  .finish-chip .sail-no{
    font-family:var(--font-data); font-size:11px; color:var(--glow);
    letter-spacing:0.04em;
  }

  /* podium accents — first three finishers get a subtle top-edge glow */
  .finish-chip.p1{ border-color:rgba(255,209,102,0.55); }
  .finish-chip.p1 .pos{ color:#ffd166; }
  .finish-chip.p2{ border-color:rgba(200,214,224,0.5); }
  .finish-chip.p2 .pos{ color:#dbe6ea; }
  .finish-chip.p3{ border-color:rgba(255,140,94,0.5); }
  .finish-chip.p3 .pos{ color:var(--signal); }

  @media (max-width:560px){
    .finish-chip{ width:132px; }
  }

  /* =========================================================
     TILE GRID — doubles as primary navigation
     ========================================================= */
  .section-head{
    max-width:1180px; margin:64px auto 22px; padding:0 28px;
    display:flex; align-items:baseline; justify-content:space-between; gap:16px; flex-wrap:wrap;
  }
  .section-head h2{
    font-family:var(--font-display); font-size:22px; color:var(--foam); font-weight:600;
  }
  .section-head p{ font-size:13.5px; color:var(--foam-dim); }

  .tile-grid{
    max-width:1180px; margin:0 auto; padding:0 28px 90px;
    display:grid; grid-template-columns:repeat(4, 1fr); gap:18px;
  }
  @media (max-width:980px){ .tile-grid{ grid-template-columns:repeat(2, 1fr); } }
  @media (max-width:560px){ .tile-grid{ grid-template-columns:1fr; } }

  .tile{
    padding:24px; text-decoration:none; color:inherit;
    display:flex; flex-direction:column; gap:14px; min-height:168px;
    transition:transform 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }
  .tile:hover, .tile:focus-visible{
    transform:translateY(-4px);
    border-color:rgba(94,234,212,0.4);
    background:linear-gradient(155deg, var(--glass-fill-hi), var(--glass-fill));
    outline:none;
  }
  .tile-icon{
    width:38px; height:38px; border-radius:11px;
    background:var(--glass-fill-hi); border:1px solid var(--glass-border);
    display:flex; align-items:center; justify-content:center;
    color:var(--glow);
  }
  .tile h3{
    font-family:var(--font-display); font-size:16px; font-weight:600; color:var(--foam);
  }
  .tile p{ font-size:13px; line-height:1.5; color:var(--foam-dim); }
  .tile .tag{
    margin-top:auto; font-family:var(--font-data); font-size:10px;
    letter-spacing:0.1em; text-transform:uppercase; color:var(--signal);
  }

  /* =========================================================
     FOOTER
     ========================================================= */
  footer{
    border-top:1px solid var(--glass-border);
    padding:26px 28px; margin-top:0;
    display:flex; align-items:center; justify-content:space-between; gap:16px; flex-wrap:wrap;
    font-size:12.5px; color:var(--foam-dim);
    position:relative; z-index:1;
  }
  footer a{ color:var(--foam-dim); }

  @media (prefers-reduced-motion: reduce){
    body::before, .eyebrow .dot, .binnacle-needle{ animation:none !important; }
    html{ scroll-behavior:auto; }
  }
</style>
</head>
