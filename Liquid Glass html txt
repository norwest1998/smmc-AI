  <!-- ============ TILE NAV / PAGE INDEX ============ -->
  <div class="section-head">
    <h2>Club instruments</h2>
    <p>Each tile is a live view, wired to the same race sheet.</p>
  </div>

  <div class="tile-grid">
    <a class="glass tile" href="?view=dashboard">
