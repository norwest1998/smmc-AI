<body>
  <div id="loading">
    <div class="spinner"></div>
    <p>Loading images...</p>
  </div>
  
  <div id="fileList" style="display: none;"></div>
  
  <button id="processBtn" disabled>Load Selected Race Results</button>
  
  <div id="status"></div>

  <script>
    let selectedFileId = null;
    
    // Load files on page load
    google.script.run
      .withSuccessHandler(displayFiles)
      .withFailureHandler(showError)
      .getImageFiles();
    
    function displayFiles(files) {
      const loading = document.getElementById('loading');
      const fileList = document.getElementById('fileList');
      
      loading.style.display = 'none';
      fileList.style.display = 'block';
      
      if (files.length === 0) {
        fileList.innerHTML = '<p style="color: #666;">No images found in folder.</p>';
        return;
      }
      
      fileList.innerHTML = '';
      
      files.forEach(file => {
        const fileItem = document.createElement('div');
        fileItem.className = 'file-item';
        fileItem.onclick = () => selectFile(file.id, fileItem);
        
        fileItem.innerHTML = `
          <img src="${file.thumbnailUrl}" class="file-thumbnail" alt="${file.name}">
          <div class="file-name">${file.name}</div>
        `;
        
        fileList.appendChild(fileItem);
      });
    }
    
    function selectFile(fileId, element) {
      // Remove previous selection
      document.querySelectorAll('.file-item').forEach(item => {
        item.classList.remove('selected');
      });
      
      // Select current file
      element.classList.add('selected');
      selectedFileId = fileId;
      document.getElementById('processBtn').disabled = false;
    }
    
    document.getElementById('processBtn').onclick = function() {
      if (!selectedFileId) return;
      
      const statusDiv = document.getElementById('status');
      statusDiv.style.display = 'block';
      statusDiv.className = 'processing';
      statusDiv.innerHTML = '<div class="spinner"></div><p>Processing image and extracting race data...</p>';
      
      document.getElementById('processBtn').disabled = true;
      
      // Process the image and get JSON data
      google.script.run
        .withSuccessHandler(function(jsonData) {
          // Now populate the sheet with the data
          google.script.run
            .withSuccessHandler(function(result) {
              statusDiv.className = 'success';
              statusDiv.innerHTML = result.message;
              document.getElementById('processBtn').disabled = false;
            })
            .withFailureHandler(function(error) {
              statusDiv.className = 'error';
              statusDiv.innerHTML = 'Error: ' + error.message;
              document.getElementById('processBtn').disabled = false;
            })
            .populateSheet(jsonData, selectedFileId);
        })
        .withFailureHandler(function(error) {
          statusDiv.className = 'error';
          statusDiv.innerHTML = 'Error processing image: ' + error.message;
          document.getElementById('processBtn').disabled = false;
        })
        .processImageFile(selectedFileId);
    };
    
    function showError(error) {
      const loading = document.getElementById('loading');
      loading.innerHTML = '<p style="color: red;">Error: ' + error.message + '</p>';
    }
  </script>
</body>
</head>
