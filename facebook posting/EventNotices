  // Construct SVG Overlay with styling and dark gradient backdrop
  const svg = `
    <svg xmlns="http://www.w3.org/2000/svg" width="1200" height="630" viewBox="0 0 1200 630">
      <defs>
        <linearGradient id="grad" x1="0%" y1="0%" x2="0%" y2="100%">
          <stop offset="0%" stop-color="#071b2c" stop-opacity="0.65" />
          <stop offset="45%" stop-color="#0f3550" stop-opacity="0.80" />
          <stop offset="100%" stop-color="#071b2c" stop-opacity="0.95" />
