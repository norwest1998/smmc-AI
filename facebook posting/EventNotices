      </defs>

      <!-- Background Image -->
      ${base64Image ? `<image href="data:image/jpeg;base64,${base64Image}" width="1200" height="630" preserveAspectRatio="xMidYMid slice" />` : `<rect width="1200" height="630" fill="#0c2b42" />`}

      <!-- Shading Overlay for contrast -->
